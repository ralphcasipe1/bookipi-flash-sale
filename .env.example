# Local development — copy to .env and adjust:
#   cp .env.example .env
#
# Prerequisite: npm run docker:up (Valkey :6379, MongoDB :27017)
#
# Load before API/worker commands, e.g.:
#   set -a && source .env && set +a && npm run dev -w @flash-sale/api

# --- API & worker ---

VALKEY_URL=redis://localhost:6379
MONGODB_URL=mongodb://localhost:27017/flash_sale

# Sale seeding on API startup (all three required with VALKEY_URL)
SALE_START=2026-06-08T00:00:00.000Z
SALE_END=2026-12-31T23:59:59.000Z
INITIAL_STOCK=100

PORT=3000
HOST=0.0.0.0

# Set to false when running the standalone order worker (npm run dev:worker)
# ORDER_WORKER_IN_PROCESS=false

# --- Web (optional; empty uses Vite proxy to localhost:3000) ---

# VITE_API_BASE_URL=

# --- Integration tests (docker compose -f docker-compose.test.yml up -d --wait) ---

# VALKEY_URL=redis://localhost:6380
# MONGODB_URL=mongodb://localhost:27018/flash_sale

# --- Stress tests (k6) ---

# API_URL=http://localhost:3000
# STRESS_VUS=500
# STRESS_ITERATIONS=500
